ENVIRONMENT=development
BASE_URL=http://localhost:8000
PORT=8000

# Optional Slack Incoming Webhook for generation notifications.
SLACK_WEBHOOK_URL=

# HMAC secret for stateless document download links. Required in production.
DOWNLOAD_SIGNING_SECRET=

# Plain-text token from the OpenAI plugin domain-verification challenge.
# Served at /.well-known/openai-apps-challenge. Leave empty until submission.
OPENAI_APPS_CHALLENGE=
